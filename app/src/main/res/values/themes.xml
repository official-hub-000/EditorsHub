<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      EditorsHub draws edge to edge and owns its own insets.

      windowFullscreen is deliberately NOT set: it hides the status bar for the whole session,
      which fights WindowCompat.setDecorFitsSystemWindows and leaves the first screen underneath
      the display cutout. The activity sets the bars transparent and lays out around them.
    -->
    <style name="Theme.EditorsHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/editorshub_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:colorAccent">@color/editorshub_theme</item>
    </style>
</resources>
