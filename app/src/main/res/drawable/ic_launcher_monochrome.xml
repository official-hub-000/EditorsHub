<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+).

  A monochrome layer is a MASK, not a picture: the launcher tints the alpha it finds with the
  user's theme colour. It must be a silhouette on transparent. Reusing the scaled bitmap here made
  themed icons either blank or a solid block on launchers that treat the layer as opaque.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,25h12v58H24z" />
    <!-- Top arm, the longest -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,25h60v11H24z" />
    <!-- Middle arm, with the playhead notch on its leading edge -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,48h46v12H24z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M70,48l7,6l-7,6z" />
    <!-- Bottom arm, the shortest -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,72h57v11H24z" />
</vector>
