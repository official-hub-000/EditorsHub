<?xml version="1.0" encoding="utf-8"?>
<!--
  The brand field: a diagonal teal-to-blue gradient.
  Used as the adaptive icon background and behind the in-app wordmark, so the launcher and the
  editor are visibly the same product.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#3AD9C6"
        android:centerColor="#22B8D4"
        android:endColor="#2B7FFF"
        android:type="linear" />
</shape>
