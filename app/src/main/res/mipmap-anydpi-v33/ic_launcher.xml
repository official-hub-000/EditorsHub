<?xml version="1.0" encoding="utf-8"?>
<!-- API 33 can animate the icon; the monochrome layer is what themed icons use. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_brand_background" />
    <foreground android:drawable="@drawable/ic_brand_foreground" />
    <monochrome android:drawable="@drawable/ic_brand_foreground" />
</adaptive-icon>
