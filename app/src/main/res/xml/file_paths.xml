<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Rendered videos, shared through the system sheet. Must match where Exporter writes. -->
    <cache-path name="export" path="export/" />
    <!-- Rendered stills, shared the same way. -->
    <cache-path name="share" path="share/" />
    <!-- Media copied out of a picker grant, so an expiring grant cannot lose it. -->
    <files-path name="media" path="media/" />
</paths>
